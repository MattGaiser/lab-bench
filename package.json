{
  "name": "lab-bench",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A focused authoring workbench for motor-control troubleshooting labs.",
  "author": "Matthew Gaiser",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/notices.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/assistant.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:browsers": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "start": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/package.mjs",
    "test:live": "node scripts/live-assistant.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
